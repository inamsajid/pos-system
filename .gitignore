# ==========================================
# NORTHSTAR POS — GIT EXCLUSIONS (.gitignore)
# ==========================================

# 1. Environment & Local Variables
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
**/.env
**/.env.*
!**/.env.example
**/.dev.vars
**/.dev.vars.*
!**/.dev.vars.example

# 2. Authentication Secrets, Private Keys & Credentials
*.pem
*.key
*.pkcs12
*.p12
*.pfx
*.cer
*.crt
*.csr
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*.secret
*.secrets
*secrets.json
credentials.json
service-account*.json
client_secret*.json
auth_secret*

# 3. Cloudflare Workers & Wrangler Local Databases / State
.wrangler/
**/.wrangler/
.mf/
**/.mf/

# 4. Dependencies
node_modules/
**/node_modules/

# 5. Build Outputs
dist/
**/dist/
dist-ssr/
**/dist-ssr/
build/
**/build/
.turbo/
*.local

# 6. Local Database Files, WALs & Backups
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
*.db
*.db3
*.db-shm
*.db-wal
*.s3db
*.bak
*.backup
*.dump
*.sql.bak
*.sql.dump
*.sql.backup
backups/
**/backups/
dumps/
**/dumps/
db-backups/
**/db-backups/

# 7. Real Store / Customer Data & Sensitive Exports
customer-data/
**/customer-data/
store-data/
**/store-data/
exports/
**/exports/
uploads/
**/uploads/
receipts/
**/receipts/
*.csv
!tests/**/*.csv

# 8. Logs & Diagnostic Traces
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 9. Editor & OS Metadata
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
