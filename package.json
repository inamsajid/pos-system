{
  "name": "pos-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "build": "tsc -b && vite build",
    "build:worker": "tsc -p tsconfig.worker.json --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply pos-system-local --local",
    "db:status:local": "wrangler d1 migrations list pos-system-local --local",
    "db:seed:local": "wrangler d1 execute pos-system-local --local --file=worker/seed_dev.sql",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "dexie": "^4.4.7",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261108.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.0",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
